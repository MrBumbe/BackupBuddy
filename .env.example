# BackupBuddy environment variables
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit it.

# Path to the gatekeeper configuration file
BACKUPBUDDY_CONFIG_PATH=

# Path to the gatekeeper data directory (contains catalog.db, cluster.db)
BACKUPBUDDY_DATA_DIR=

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
BACKUPBUDDY_LOG_LEVEL=INFO

# Port for the gatekeeper web GUI (bound to Tailscale interface only)
BACKUPBUDDY_PORT=8080

# Path where lifeboat key is stored (default: /etc/backup-buddy/lifeboat.key)
# Override only for development/testing — never change in production
BACKUPBUDDY_LIFEBOAT_KEY_PATH=
